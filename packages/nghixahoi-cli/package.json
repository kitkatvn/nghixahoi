{
  "name": "@kitkatvn/nghixahoi",
  "version": "0.2.17",
  "description": "Local aggregate activity server for Kit=Code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitkatvn/nghixahoi.git",
    "directory": "packages/nghixahoi-cli"
  },
  "publishConfig": {
